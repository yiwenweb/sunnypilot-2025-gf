BU_: VCU EPS ESP MPC BCM RADAR

CM_ "=============================================================================";
CM_ "BYD Tang DM 2018 CAN Database for sunnypilot (Modified for 0km/h ACC/LKA)";
CM_ "Version: 2026.02.2 - Fixed errors +补充遗漏信号 +适配0km/h激活逻辑";
CM_ "Optimized for 18款比亚迪唐DM (BYD Tang DM 2018 PHEV)";
CM_ "适配说明：原厂≥30km/h激活ACC/≥60km/h激活LKA，本DBC适配sunnypilot支持0km/h激活";
CM_ "=============================================================================";
CM_ "";
CM_ "=== SIGNAL VERIFICATION STATUS LEGEND ===";
CM_ "[VERIFIED]   - Signal confirmed against byd_唐dm.dbc reference and/or real vehicle data";
CM_ "[UNVERIFIED] - Signal needs real vehicle data validation before use";
CM_ "[PARTIAL]    - Signal partially verified, some aspects need validation";
CM_ "[DO_NOT_USE] - Control signal that should NOT be used until fully validated";
CM_ "";
CM_ "=== CHECKSUM CALCULATION METHOD (CORRECTED) ===";
CM_ "BYD Tang DM 2018 正确校验和算法: CHECKSUM = (0xFF - sum(data[0:7])) & 0xFF";
CM_ "  验证方法: sum(all 8 bytes) & 0xFF == 0xFF";
CM_ "  通过实车嗅探验证 (sniff_mpc_frames.py, 39.5秒采样)";
CM_ "  790/792/813/814/815 全部符合此算法";
CM_ "  Byte Order: Little-endian (Intel byte order)";
CM_ "  Position: Checksum is always in byte 7 (bits 56-63) of 8-byte messages";
CM_ "  Python Implementation:";
CM_ "    def byd_checksum(dat: bytes) -> int:";
CM_ "        return (0xFF - sum(dat[:7])) & 0xFF";
CM_ "";
CM_ "=== COUNTER FIELD NOTES ===";
CM_ "  - Most messages use 4-bit counter (0-15) at bits 48-51 or 52-55";
CM_ "  - EPS (287) uses 8-bit counter (0-255) at bits 32-39";
CM_ "  - Counter increments by 1 each message cycle, wraps around at max value";
CM_ "";
CM_ "=== VERIFIED MESSAGES (Safe for CarState parsing) ===";
CM_ "  EPS (287), CARSPEED (289), DRIVE_STATE (578), PEDAL (834)";
CM_ "  BCM (301), STALKS (307), EPB (85), YAW_RATE (546), AXAY (547)";
CM_ "  ACC_HUD_ADAS (813), ACC_EPS_STATE (792), PCM_BUTTONS (944)";
CM_ "";
CM_ "=== UNVERIFIED/PARTIAL MESSAGES (Use with caution) ===";
CM_ "  ACC_MPC_STATE (790) - LKAS control signals need validation";
CM_ "  ACC_AEB (815) - AEB signals not in reference DBC";
CM_ "  RADAR_MRR (884) - Radar distance ranges need validation";
CM_ "=============================================================================";
CM_ "";
CM_ "=== （五）重要安全提醒 ===";
CM_ "1. 仅辅助，不可脱手，随时接管";
CM_ "2. 弯道、雨雪、标线模糊、施工路段慎用/关闭";
CM_ "3. 不识别行人、非机动车、静止障碍物";
CM_ "4. 升级后功能以4S店开通版本为准";
CM_ "";

